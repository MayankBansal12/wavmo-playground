OPENCODE_API_KEY=
OPENCODE_API_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_USER_AGENT=wavmo-server/1.0
PORT=8000
CORS_ORIGIN=http://localhost:3001

# OpenCode Go model configuration (optional; defaults shown)
OPENCODE_MODEL_PLANNING=minimax-m3
OPENCODE_MODEL_PLANNING_FALLBACK=deepseek-v4-flash
OPENCODE_MODEL_WRITER_HIGH_END=minimax-m3
OPENCODE_MODEL_WRITER_LIGHT=deepseek-v4-flash
OPENCODE_MODEL_REVIEW_HIGH_END=minimax-m3
OPENCODE_MODEL_REVIEW_LIGHT=deepseek-v4-flash
OPENCODE_MODEL_IMPROVEMENT_HIGH_END=minimax-m3
OPENCODE_MODEL_IMPROVEMENT_LIGHT=deepseek-v4-flash
OPENCODE_MODEL_RESEARCH=minimax-m3
OPENCODE_MODEL_RESEARCH_FALLBACK=deepseek-v4-flash

# Rate Limiting (Redis)
REDIS_URL=redis://default:password@host:port
RATE_LIMIT_DEFAULT=5
RATE_LIMIT_WINDOW_SECONDS=86400
RATE_LIMIT_BYPASS_DEFAULT_LIMIT=200
