OPENCODE_API_KEY=
OPENCODE_API_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_USER_AGENT=wavmo-server/1.0
PORT=8000
CORS_ORIGIN=http://localhost:3001

# One model for all LLM tasks (optional; default shown)
OPENCODE_MODEL=minimax-m3

# Rate Limiting (Redis)
REDIS_URL=redis://default:password@host:port
RATE_LIMIT_DEFAULT=5
RATE_LIMIT_WINDOW_SECONDS=86400
RATE_LIMIT_BYPASS_DEFAULT_LIMIT=200
